~[tlist_sql;
    SELECT
        COALESCE(
            JSON_ARRAYAGG(
                JSON_OBJECT(
                    'transaction_id' VALUE u_student_med_inv_txn.id,
                    'medication_id' VALUE u_student_med_inv_txn.u_student_medication_id,
                    'transaction_type' VALUE u_student_med_inv_txn.transaction_type,
                    'quantity_change' VALUE u_student_med_inv_txn.quantity_change,
                    'event_date' VALUE TO_CHAR(u_student_med_inv_txn.event_date, 'YYYY-MM-DD'),
                    'event_time' VALUE u_student_med_inv_txn.event_time,
                    'users_dcid' VALUE u_student_med_inv_txn.users_dcid,
                    'user_name' VALUE users.first_name || ' ' || users.last_name,
                    'user_middle_name' VALUE users.middle_name,
                    'notes' VALUE u_student_med_inv_txn.notes,
                    'medication_name' VALUE u_student_med_inv_txn.medication_name,
                    'dose_amount' VALUE u_student_med_inv_txn.dose_amount,
                    'variable_dose' VALUE u_student_med_inv_txn.variable_dose,
                    'dose_unit' VALUE u_student_med_inv_txn.dose_unit,
                    'inventory_unit' VALUE u_student_med_inv_txn.inventory_unit,
                    'route' VALUE u_student_med_inv_txn.route,
                    'frequency' VALUE u_student_med_inv_txn.frequency,
                    'reversal_of_transaction_id' VALUE u_student_med_inv_txn.reversal_of_transaction_id,
                    'administration_quantity' VALUE u_student_med_inv_txn.administration_quantity,
                    'correction_date' VALUE TO_CHAR(u_student_med_inv_txn.correction_date, 'YYYY-MM-DD'),
                    'correction_time' VALUE u_student_med_inv_txn.correction_time,
                    'correction_users_dcid' VALUE u_student_med_inv_txn.correction_users_dcid,
                    'correction_user_name' VALUE correction_users.first_name || ' ' || correction_users.last_name,
                    'correction_reason' VALUE u_student_med_inv_txn.correction_reason,
                    'not_given_reason_code' VALUE u_student_med_inv_txn.not_given_reason_code,
                    'not_given_reason_label' VALUE u_student_med_inv_txn.not_given_reason_label,
                    'recorded_date' VALUE TO_CHAR(u_student_med_inv_txn.recorded_date, 'YYYY-MM-DD'),
                    'recorded_time' VALUE u_student_med_inv_txn.recorded_time
                    NULL ON NULL
                    RETURNING CLOB
                )
                ORDER BY u_student_med_inv_txn.event_date DESC,
                    u_student_med_inv_txn.id DESC
                RETURNING CLOB
            ),
            TO_CLOB(CHR(91) || CHR(93))
        ) AS json_result
    FROM u_student_med_inv_txn
    INNER JOIN u_student_medication
        ON u_student_medication.id = u_student_med_inv_txn.u_student_medication_id
    LEFT JOIN users
        ON users.dcid = u_student_med_inv_txn.users_dcid
    LEFT JOIN users correction_users
        ON correction_users.dcid = u_student_med_inv_txn.correction_users_dcid
    LEFT JOIN students
        ON students.dcid = u_student_medication.studentsdcid
    WHERE u_student_medication.yearid = ~(gpv.yearID;num)
        AND ~(gpv.curSchoolID;num) IN (0, u_student_medication.schoolid)
        AND (
            students.dcid = ~(gpv.curStudentDCID)
            OR ~(gpv.curStudentDCID) = 0
        )
;]~(data)[/tlist_sql]
